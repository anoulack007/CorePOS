meta {
  name: Register
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/auth/register
  body: json
  auth: none
}

body:json {
  {
    "store_id": "{{storeId}}",
    "username": "admin",
    "password": "password123",
    "full_name": "Store Owner",
    "email": "admin@example.com",
    "phone": "1234567890"
  }
}
